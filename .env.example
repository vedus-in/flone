# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. These are the only variables the app
# reads. Never commit a real `.env` — it is gitignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma. Required; the app will not boot
# without it. The value below is a placeholder for a local database — replace
# the credentials, host, and database name with your own.
#
# On Railway, do not paste a connection string here. Add a Postgres database to
# the project and set this as a reference variable on the app service:
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flone?schema=public"

# ---------------------------------------------------------------------------
# Email (Resend). Required in production; all three are optional locally.
# ---------------------------------------------------------------------------

# API key from https://resend.com/api-keys.
#
# LEAVE THIS EMPTY IN DEVELOPMENT. With no key the app does not send anything:
# it prints each message to the console instead, including the full
# verification / reset / invitation link, so every flow is clickable straight
# out of `bun run dev` with no Resend account.
RESEND_API_KEY=

# The From address. Its domain must be verified in Resend, or every send is
# rejected. A display name is optional: `Flone <no-reply@example.com>`.
EMAIL_FROM="Flone <no-reply@example.com>"

# The public origin, used to build every link in every email. No trailing path.
#
# REQUIRED IN PRODUCTION, and deliberately not derived from the request. A link
# built out of the Host header is host-header poisoning: an attacker sets the
# header, the victim gets a genuine email from the real system, and the link
# hands the one-time token to the attacker's domain. With a key set but this
# missing, the app logs `[email] not_configured` and sends nothing rather than
# send a broken link. Defaults to http://localhost:3000 in development.
APP_URL="https://flone.example.com"

# Optional — you almost never set this by hand. Next.js sets it for you:
# "development" for `bun run dev`, "production" for `bun run build` / `bun run start`.
# It is read in exactly two places: the Prisma client singleton (dev-only global
# caching) and the session cookie (production switches the cookie to the
# `__Host-` prefix and turns on the Secure flag).
# NODE_ENV="development"
