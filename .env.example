# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. These are the only variables the app
# reads. Never commit a real `.env` — it is gitignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma. Required; the app will not boot
# without it. The value below is a placeholder for a local database — replace
# the credentials, host, and database name with your own.
#
# On Railway, do not paste a connection string here. Add a Postgres database to
# the project and set this as a reference variable on the app service:
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flone?schema=public"

# Optional — you almost never set this by hand. Next.js sets it for you:
# "development" for `bun run dev`, "production" for `bun run build` / `bun run start`.
# It is read in exactly two places: the Prisma client singleton (dev-only global
# caching) and the session cookie (production switches the cookie to the
# `__Host-` prefix and turns on the Secure flag).
# NODE_ENV="development"
