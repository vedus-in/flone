// Flone — canonical Prisma schema.
//
// SPEC §2 as amended by docs/superpowers/specs/2026-08-05-linear-project-workspace-design.md.
// The Project is the team: it owns the key, the workflow states, the labels and
// the cycles. A Board is what Linear calls a project — a grouping chip on an
// issue — and is OPTIONAL. An issue has exactly one status, and that status
// belongs to the Project, never to a board.
//
// A Workspace groups Projects inside an Organization and is a URL segment:
// `/orgs/acme/platform/ENG`. It is presentation and naming only — it owns no
// states, labels, cycles or members. The Organization remains the single
// multi-tenant boundary.
//
// Index rationale (final): no standalone index where the column is already the
// leading column of a composite unique or index. `Ticket.boardId`,
// `Ticket.cycleId`, `Ticket.parentId` and `Project.workspaceId` DO each carry
// one — they are foreign keys that views filter on directly and none of them
// leads a composite.
// No index on Ticket.createdById, Ticket.assigneeId or Comment.authorId —
// nothing filters by them.
//
// Referential actions: the tenant tree cascades (Organization ->
// Membership/Workspace/Project -> Board/WorkflowState/Cycle/Label/Ticket ->
// Comment, User -> Session). Four deliberate exceptions:
//   - Project.workspaceId is Restrict. A workspace holding projects cannot be
//     deleted; the UI empties it first. Deleting a grouping must never delete
//     the work grouped under it.
//   - Ticket.stateId is Restrict. A state holding issues cannot be deleted;
//     the UI reassigns first. Deleting a status must never delete work.
//   - Ticket.boardId is SetNull. Deleting a board drops the chip and keeps the
//     issues. This CHANGED with the Linear rework: a board delete used to
//     cascade its tickets away.
//   - Ticket.parentId is SetNull, so removing an epic orphans its children
//     rather than deleting them.
// Ticket.createdById and Comment.authorId stay Restrict so a user cannot be
// hard-deleted while authored content exists. Ticket.assigneeId is SetNull.
// ChallengePick cascades on BOTH sides: a pick is a bookmark, not content, so
// deleting either the person or the issue should take it with them.
//
// `position` is never unique-constrained. It is a sort hint (SPEC §6.10),
// dense within a (projectId, stateId) pair on Ticket, and across one person's
// whole Daily Challenges board on ChallengePick.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Site-wide administrator. Distinct from the per-organization Role: an
  /// admin governs the instance (registration, other admins), NOT tenant data.
  /// Being an admin grants NO access to any organization's boards or tickets.
  isAdmin      Boolean  @default(false)
  /// Null means the address has never been confirmed. `signIn` refuses to mint
  /// a session for such an account, so the migration that adds this column MUST
  /// backfill every pre-existing row or the deploy locks out every user.
  ///
  /// Set three ways: clicking a verification link, clicking a password-reset
  /// link, and accepting an invitation -- all three prove the address receives
  /// mail, which is the whole claim the column makes.
  emailVerified DateTime?

  /// E.164, and set ONLY by its owner on `/account`. Reminder calls go here.
  ///
  /// Nobody else may write it, and nothing may be called until `phoneVerified`
  /// is stamped: without both rules this column is a robocall vector, because
  /// scheduling a daily reminder for yourself is something any member may do.
  phone         String?
  /// Null means the number has never answered a verification call. The exact
  /// counterpart of `emailVerified`, enforced in the same place -- the
  /// scheduler -- so a new call site cannot forget it.
  phoneVerified DateTime?
  /// sha256 of the 6-digit code the verification call speaks. Hashed for the
  /// same reason session tokens are, and CLEARED ON THE FIRST ATTEMPT whether
  /// or not it matched: one guess per placed call is what makes six digits
  /// enough without an attempt counter or a rate limiter.
  phoneCodeHash      String?
  phoneCodeExpiresAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Per-type notification preferences. These gate NOTIFICATIONS only; security
  /// mail (password changed, MCP token created) ignores them, because a user who
  /// has muted notifications has not consented to silent account takeover.
  notifyAssigned      Boolean @default(true)
  notifyComments      Boolean @default(true)
  notifyOrgMembership Boolean @default(true)

  sessions        Session[]
  memberships     Membership[]
  createdTickets  Ticket[]     @relation("TicketCreatedBy")
  assignedTickets Ticket[]     @relation("TicketAssignee")
  comments        Comment[]
  ledBoards       Board[]      @relation("BoardLead")
  savedViews      SavedView[]
  emailTokens     EmailToken[]
  challengePicks  ChallengePick[]
  reminders        Reminder[]  @relation("ReminderRecipient")
  createdReminders Reminder[]  @relation("ReminderCreatedBy")
  attachments      Attachment[]
  recurringTickets        RecurringTicket[] @relation("RecurringTicketAssignee")
  createdRecurringTickets RecurringTicket[] @relation("RecurringTicketCreatedBy")

  @@index([isAdmin])
}

/// Purpose of a one-time emailed link. Part of the `where` clause on every
/// consume, so a token minted for one flow cannot be presented to another.
enum EmailTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE
}

/// A one-time credential delivered by email.
///
/// Constructed exactly like `Session` and for the same reasons: 256 bits from
/// `randomBytes`, only `sha256(token)` stored under a unique index, so
/// verification is a lookup by key and a database leak yields nothing usable.
/// SHA-256 rather than scrypt is right here for the same reason it is right for
/// sessions -- a uniformly random 256-bit value has no dictionary.
///
/// INVITE is the only purpose that populates `organizationId`, `role` and
/// `invitedById`, and it is the only purpose whose `userId` is null (the invitee
/// has no account yet). That invariant is held by `src/lib/email-token.ts`, not
/// by the schema: expressing it in SQL costs three partial constraints to
/// prevent a shape only this app's own code can produce.
model EmailToken {
  id             String            @id @default(cuid())
  tokenHash      String            @unique
  purpose        EmailTokenPurpose
  /// The address the link was sent to. For INVITE there may be no `User` yet,
  /// which is why the address is stored here rather than read through `userId`.
  email          String
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The role the invitation grants on acceptance. Never read from the accept
  /// form -- an invitee must not be able to choose their own role.
  role           Role?
  invitedById    String?
  expiresAt      DateTime
  /// Stamped by the single atomic `updateMany` that consumes the token. Non-null
  /// means spent; there is no delete-on-use, so a second click can be told the
  /// link was already used rather than that it never existed.
  usedAt         DateTime?
  createdAt      DateTime          @default(now())

  /// Drives "invalidate this user's other tokens of this purpose" on issue, and
  /// the pending-invitation list on the organization settings page.
  @@index([email, purpose])
  @@index([organizationId, purpose])
  @@index([expiresAt])
}

/// Single-row table holding instance-wide settings. The id is pinned to
/// "singleton" so there can only ever be one row.
model AppSetting {
  id                  String   @id @default("singleton")
  registrationEnabled Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  updatedById         String?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  workspaces  Workspace[]
  projects    Project[]
  emailTokens EmailToken[]
  reminders   Reminder[]
}

/// A named grouping of Projects inside an Organization, and a URL segment:
/// `/orgs/acme/platform/ENG`.
///
/// It owns NOTHING but its projects. States, labels and cycles stay on the
/// Project, and membership stays on the Organization -- a workspace is visible
/// to every member of its org. Adding a second membership boundary here would
/// duplicate what Organization already is.
///
/// The slug shares `slugSchema` with organizations, so `RESERVED_SLUGS` already
/// stops a workspace from shadowing the `settings` and `go` siblings that sit
/// beside it under `/orgs/[orgSlug]/`.
model Workspace {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  /// Sidebar order, hand-arranged by an admin. The ORGANIZATION's order, not
  /// the viewer's: everyone sees the same sidebar, which is what keeps this a
  /// column here instead of a per-user join table.
  ///
  /// Every pre-existing row starts at 0, so ties are normal and `WORKSPACE_ORDER`
  /// breaks them by name -- a list nobody has arranged yet reads alphabetically,
  /// exactly as it did before this column existed.
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects Project[]

  @@unique([organizationId, slug])
  @@index([organizationId, position])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// The TEAM. Owns the issue key, the workflow states, the labels and the
/// cycles. Everything a Linear team settings page governs lives here.
model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Required: every project lives in exactly one workspace. Restrict, not
  /// Cascade -- a workspace holding projects cannot be deleted, because doing so
  /// would take every issue in them with it. Same reasoning as `Ticket.stateId`:
  /// deleting a container must never delete work. The UI empties a workspace
  /// (move the projects out, or delete them individually) before it can go.
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name           String
  /// Unique per ORGANIZATION, not per workspace. The key is the issue prefix, so
  /// `VED-153` has to name exactly one issue no matter which workspace it sits
  /// in. This is also what keeps the legacy-URL redirect unambiguous forever.
  key            String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// Cycle cadence. Cycles are generated lazily on read from these four
  /// fields, so there is no scheduler and no cycle rows for a project that
  /// never opens the page.
  cyclesEnabled  Boolean @default(true)
  cycleWeeks     Int     @default(2)
  /// ISO weekday the cycle starts on: 1 = Monday .. 7 = Sunday.
  cycleStartDay  Int     @default(1)
  /// How many cycles beyond the current one to keep materialized.
  upcomingCycles Int     @default(3)

  boards     Board[]
  states     WorkflowState[]
  cycles     Cycle[]
  labels     Label[]
  tickets    Ticket[]
  savedViews SavedView[]
  reminders  Reminder[]
  recurringTickets RecurringTicket[]

  @@unique([organizationId, key])
  @@index([workspaceId])
}

/// What an issue's status MEANS, independent of what a team called it.
///
/// This is the load-bearing field of the whole rework. It decides which tab an
/// issue falls under, whether it counts as done for cycle and sub-issue
/// progress, and whether a transition stamps startedAt / completedAt. A team
/// may rename "In Review" to anything; the type is what the app reasons about.
enum WorkflowStateType {
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELED
}

model WorkflowState {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      WorkflowStateType
  /// Token name from the app's palette, not a raw hex value, so a theme change
  /// does not have to rewrite rows.
  color     String            @default("gray")
  position  Int
  createdAt DateTime          @default(now())

  tickets Ticket[]

  @@unique([projectId, name])
  @@index([projectId, position])
}

/// A time-boxed sprint. Numbered per project and generated lazily; see
/// `ensureCycles` in src/lib/cycles.ts.
model Cycle {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  name      String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@unique([projectId, number])
  @@index([projectId, startsAt])
}

model Label {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("gray")
  createdAt DateTime @default(now())

  tickets Ticket[] @relation("TicketLabels")
  recurringTickets RecurringTicket[] @relation("RecurringTicketLabels")

  @@unique([projectId, name])
}

enum BoardStatus {
  BACKLOG
  PLANNED
  STARTED
  PAUSED
  COMPLETED
  CANCELED
}

/// What Linear calls a project: a named grouping of issues inside a team,
/// rendered as the chip on an issue row. Optional — an issue need not be in one.
model Board {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  description String?
  status     BoardStatus @default(BACKLOG)
  color      String      @default("gray")
  leadId     String?
  lead       User?       @relation("BoardLead", fields: [leadId], references: [id], onDelete: SetNull)
  targetDate DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tickets Ticket[]

  @@index([projectId])
}

model Ticket {
  id          String         @id @default(cuid())
  /// Denormalized from the board deliberately: the board is nullable now and
  /// every project-level query roots here. Only ever written from an
  /// authorized context, never from client input.
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boardId     String?
  board       Board?         @relation(fields: [boardId], references: [id], onDelete: SetNull)
  stateId     String
  state       WorkflowState  @relation(fields: [stateId], references: [id], onDelete: Restrict)
  cycleId     String?
  cycle       Cycle?         @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Ticket?        @relation("TicketParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Ticket[]       @relation("TicketParent")
  labels      Label[]        @relation("TicketLabels")
  number      Int
  title       String
  description String?        @db.Text
  position    Int
  createdById String
  createdBy   User           @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assigneeId  String?
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority    Priority       @default(NONE)
  /// Date only in intent; stored as a timestamp because Postgres via Prisma has
  /// no plain date type here. Null means no due date.
  dueDate     DateTime?
  /// Stamped on the transition INTO a STARTED / COMPLETED state and cleared on
  /// the way back out. The cycle burndown reads completedAt.
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  comments       Comment[]
  challengePicks ChallengePick[]
  attachments    Attachment[]

  @@unique([projectId, number])
  @@index([projectId, stateId, position])
  @@index([projectId, priority])
  @@index([projectId, dueDate])
  @@index([boardId])
  @@index([cycleId])
  @@index([parentId])
  @@index([stateId])
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// One issue on one person's Daily Challenges board.
///
/// PURELY ADDITIVE. Nothing about picking or clearing a challenge writes to
/// `Ticket`, so a challenge board cannot change what any other view shows. The
/// single write the feature makes to shared data is the status change a column
/// move performs, and that goes through the same `setIssueState` the project
/// board already calls -- which is why the two can never disagree. There is no
/// second copy of a status to keep in sync, because an issue has exactly one and
/// it belongs to the Project (see `WorkflowState`).
///
/// Deliberately NOT a `Board`: `Ticket.boardId` is single-valued, so filing an
/// issue under a challenge board would take it OFF the board it belongs to --
/// the exact opposite of cherry-picking. And deliberately not a `Label`: labels
/// are per-project and shared by everyone, where a pick is per-person and spans
/// every project in the organization.
///
/// No `date` column, and no scheduler. "Daily" is the habit, not the mechanism:
/// a pick sits here until its owner drops it in the Completed column. That also
/// means there is no timezone to argue about.
model ChallengePick {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// Where this card sits on the owner's board, read top-left to bottom-right
  /// across ALL columns -- picks span projects, so `Ticket.position` (dense per
  /// project and state) cannot say it. Defaults to 0, which leaves a board
  /// nobody has dragged sorted by priority, exactly as before.
  position  Int      @default(0)

  /// One pick per person per issue, so picking something twice is a no-op rather
  /// than a duplicate card. Per the index rationale at the top of this file
  /// `userId` gets no index of its own -- it leads this pair -- while `ticketId`
  /// leads nothing and is what the "already on your board?" search filter walks.
  @@unique([userId, ticketId])
  @@index([ticketId])
}

enum ReminderRepeat {
  ONCE
  DAILY
  WEEKLY
}

/// How a reminder reaches its recipient. `BOTH` is one row and one claim, so a
/// reminder that emails and calls still fires at most once.
enum ReminderChannel {
  EMAIL
  CALL
  BOTH
}

/// A scheduled email nudge. PURELY ADDITIVE: nothing in the reminder flow reads
/// or writes a Ticket, a Board or a WorkflowState, so this table cannot change
/// what any existing view shows.
///
/// SCOPE IS A NULLABLE FOREIGN KEY, NOT AN ENUM. `projectId == null` means the
/// reminder is about the whole organization; non-null means one project. A
/// second `scope` column would be a value that could disagree with the id beside
/// it, and there is no third scope to make it worth the risk.
///
/// `nextRunAt` is the ONLY thing the scheduler reads, and writing it is how a
/// send is claimed: the tick advances it with a conditional `updateMany` that
/// matches on the value it read, so two overlapping ticks cannot both send the
/// same occurrence. Null means "not scheduled" -- a one-time reminder that has
/// already fired -- which is also why the due query (`nextRunAt <= now`) needs
/// no second `active` flag to skip them.
///
/// `tzOffsetMinutes` is `Date.prototype.getTimezoneOffset()` from the creator's
/// browser, stored so the cron process can render the time the person actually
/// picked. See `src/lib/reminder-math.ts` for the arithmetic and for the DST
/// ceiling this accepts.
///
/// Both User relations cascade. A reminder is a notification setting, not
/// authored content, so unlike `Ticket.createdById` there is nothing here worth
/// blocking a user delete over.
model Reminder {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Null = organization scope. Cascade, not SetNull: deleting a project must
  /// not silently promote its reminders to organization-wide ones.
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  repeat         ReminderRepeat @default(ONCE)
  /// Defaulted to EMAIL, which is what every pre-existing row becomes: the
  /// migration adds the column with a default and rewrites nothing, so no
  /// reminder scheduled before this feature suddenly starts phoning anyone.
  channel        ReminderChannel @default(EMAIL)
  nextRunAt      DateTime?
  lastSentAt     DateTime?
  tzOffsetMinutes Int           @default(0)
  recipientId    String
  recipient      User           @relation("ReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation("ReminderCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// The scheduler's whole query. Every other column is read only after a row
  /// has already been found through this one.
  @@index([nextRunAt])
  /// The list on `/orgs/[orgSlug]/reminders`.
  @@index([organizationId])
}

/// How often a `RecurringTicket` spawns.
///
/// DELIBERATELY NOT `ReminderRepeat`. There is no `ONCE`: a one-time pre-filled
/// ticket is called creating a ticket, and that form already exists. And there
/// IS a `WEEKDAYS`, because a ticket is work and work has working days, where a
/// reminder is a nudge and fires whenever it was asked to. Two different value
/// sets, so two enums rather than one union that is wrong at both ends.
enum TicketRepeat {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

/// A template that the scheduler turns into a real `Ticket` on a cadence.
///
/// Design: docs/superpowers/specs/2026-08-16-recurring-tickets-design.md
///
/// PURELY ADDITIVE. The only write this feature makes to shared data is
/// creating a ticket, and it goes through the same `insertTicket` transaction
/// `createIssue` calls -- extracted, not copied, so the two cannot disagree
/// about numbering, positioning or lifecycle stamps.
///
/// `nextRunAt` is the ONLY thing the scheduler reads, and writing it is how a
/// spawn is claimed: the tick advances it with a conditional `updateMany` that
/// matches on the value it read, so two overlapping ticks cannot both spawn the
/// same occurrence. Exactly the mechanism `Reminder` uses, and null means the
/// same thing -- not scheduled -- which here is what PAUSED is. A paused
/// template keeps its accumulated description instead of being deleted to stop
/// it, and needs no second boolean the due query could disagree with.
///
/// NO `stateId`. The state a spawned ticket lands in is resolved per spawn from
/// the project's own states (`defaultComposeState`), because a stored state id
/// is a reference a deleted or renamed state turns into a dangling pointer the
/// scheduler trips over at 3am. Same indirection, same reason, as the Daily
/// Challenges board resolving columns by state TYPE.
///
/// `tzOffsetMinutes` is `Date.prototype.getTimezoneOffset()` from the creator's
/// browser, as on `Reminder` and with the same accepted DST ceiling. It is
/// load-bearing beyond formatting here: the WEEKDAYS test and the MONTHLY
/// day-of-month arithmetic both run on the template's own wall clock, or a
/// template on the far side of the date line skips the wrong days.
model RecurringTicket {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1-160, not `Ticket.title`'s 200: every spawn stamps " -- 16 Aug 2026" onto
  /// it, and the headroom is what makes the stamped title fit by construction.
  title          String
  description    String?      @db.Text
  priority       Priority     @default(NONE)
  /// SetNull, not Cascade: losing the assignee must not delete the process
  /// definition. The next occurrence spawns unassigned and sits on the board.
  assigneeId     String?
  assignee       User?        @relation("RecurringTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  repeat         TicketRepeat
  /// The first occurrence. EVERY later occurrence is computed from it, never
  /// from the previous one -- that is what stops a monthly template anchored on
  /// the 31st from clamping to the 28th in February and then staying there
  /// forever. See `nextOccurrence` in src/lib/reminder-math.ts.
  anchorAt       DateTime
  /// Null = PAUSED. The due query is `nextRunAt <= now`, which never matches
  /// null, so a paused template is skipped without a second flag.
  nextRunAt      DateTime?
  lastSpawnedAt  DateTime?
  tzOffsetMinutes Int         @default(0)
  /// Cascade, like `Reminder`: configuration, not authored content. In practice
  /// a creator with authored tickets cannot be hard-deleted anyway
  /// (`Ticket.createdById` is Restrict), so a live template always has a live
  /// creator for the rows it spawns to name.
  createdById    String
  createdBy      User         @relation("RecurringTicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  labels         Label[]      @relation("RecurringTicketLabels")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// The scheduler's whole query. Every other column is read only after a row
  /// has already been found through this one.
  @@index([nextRunAt])
  /// The list on `.../[projectKey]/recurring`.
  @@index([projectId])
}

/// A named URL. `query` is the Issues-list query string verbatim, so there is
/// no second filter language to keep in sync with the one the URL already
/// expresses.
model SavedView {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  query       String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  /// False means it is visible only to its creator.
  isShared    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, name])
  @@index([createdById])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
}

/// An image uploaded against an issue and referenced from Markdown as
/// `![alt](/api/attachments/<id>)` in its description or in one of its comments.
///
/// THE ROW IS THE PERMISSION. The bucket is private and no object URL ever
/// reaches a browser: `GET /api/attachments/[id]` walks this row up to its
/// organization exactly as every other read does, and only then mints a
/// short-lived presigned URL. So an attachment is readable by precisely the
/// people who can read the issue, and it stops being readable the moment they
/// lose access -- which a public object URL could never express.
///
/// NO BACK-REFERENCE FROM THE MARKDOWN. Nothing parses a description to find out
/// which attachments it uses, so removing the image text does not delete the
/// object and re-adding it does not resurrect anything. That is deliberate: the
/// alternative is a parser deciding when to destroy a file, and getting it wrong
/// means someone's screenshot vanishes because they edited a sentence.
///
/// `ticketId` cascades, so the rows go with the issue. The bucket objects do not
/// cascade -- nothing in Postgres can reach a bucket -- and are deleted
/// best-effort by `purgeTicketAttachments` on the delete path. An orphaned object
/// costs $0.015/GB-month and is logged; a delete that fails because the bucket is
/// down must not be a delete that fails.
///
/// `uploadedById` is Restrict for the same reason `Comment.authorId` is: this is
/// authored content, and a user with content must not be hard-deletable.
model Attachment {
  /// NO `@default(cuid())`, and the only id in this schema without one. Prisma's
  /// cuid default is generated inside the query engine, so it does not exist until
  /// the row does -- and the object key embeds the id, while the OBJECT is written
  /// before the row (a failed upload must not leave a row pointing at nothing).
  /// The upload route therefore mints a `randomUUID()` and passes it explicitly.
  id           String   @id
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// The bucket object key, `attachments/<ticketId>/<id>-<sanitized filename>`.
  /// Unique by construction (it carries the row's own id), so no constraint
  /// asserts it. The filename is in there only so a human browsing the bucket can
  /// tell what they are looking at without the database.
  key          String
  /// As the browser reported it, sanitized. Display and alt text only -- it is
  /// never used to open, route to, or serve anything.
  filename     String
  /// Constrained to the image allowlist in `src/lib/attachments.ts` at upload
  /// time. Stored because it is what the object was written with.
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  /// The purge query on ticket delete. Serving is a lookup by primary key.
  @@index([ticketId])
}
