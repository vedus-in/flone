# ---------------------------------------------------------------------------
# For `docker compose`. Copy to `.env` next to docker-compose.yml and fill it in.
# Never commit the real `.env`. Every variable is documented in full in
# `.env.example`; this file holds only what a Docker install sets.
# ---------------------------------------------------------------------------

# Required. The database password. Generate one with: openssl rand -hex 24
# Changing it after the first start does NOT change the database's password:
# Postgres only reads it when the volume is created.
POSTGRES_PASSWORD=

# Required. The public URL people open, with no trailing slash. Every emailed
# link is built from it. Anything other than localhost must be HTTPS: session
# cookies are `Secure` and browsers drop them over plain http.
APP_URL=http://localhost:3000

# The host port the app listens on.
PORT=3000

# ---------------------------------------------------------------------------
# Email. Required: sign-in needs a confirmed address. Pick ONE of these.
# ---------------------------------------------------------------------------

# The From address. Your mail provider must accept it.
EMAIL_FROM="Flone <no-reply@example.com>"

# A) Any SMTP server. 587 uses STARTTLS, 465 uses TLS from the start. With a
#    user set, a server that does not offer TLS is refused.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# B) Resend (https://resend.com). Wins over SMTP when both are set.
RESEND_API_KEY=

# C) Just trying it out: run `docker compose --profile mailpit up -d`, set
#    SMTP_HOST=mailpit and SMTP_PORT=1025 above, leave SMTP_USER empty, and
#    read every email at http://localhost:8025.

# ---------------------------------------------------------------------------
# Reminders and recurring tickets. Generate with: openssl rand -base64 32
# Unset, the scheduler endpoint stays closed and neither feature runs.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Image attachments. Optional; all four of the first four, or none.
# Any S3-compatible bucket (R2, B2, MinIO, S3). Keep it PRIVATE.
#
# S3_ENDPOINT must be reachable from people's browsers as well as from the app
# container: images are served by redirecting the browser to a short-lived
# signed URL on it. It is also built into the image's security headers, so run
# `docker compose up -d --build` after changing it.
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
